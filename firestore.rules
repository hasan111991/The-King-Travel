rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Hardened Primitives
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser()
        && ('email' in request.auth.token)
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'hasanaamir815@gmail.com';
    }

    function adminRoleDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function hasAdminDoc() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return isBootstrappedAdmin() || (
        hasAdminDoc() && adminRoleDoc().role == 'super_admin'
      );
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        hasAdminDoc() && adminRoleDoc().role in ['admin', 'super_admin']
      );
    }

    function isBookingAgent() {
      return hasAdminDoc() && adminRoleDoc().role == 'booking_agent';
    }

    function isStaff() {
      return isAdmin() || isBookingAgent();
    }

    function isNonEmptyStr(val, maxLen) {
      return val is string && val.size() >= 1 && val.size() <= maxLen;
    }

    function isOptionalStr(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    // -------------------------------------------------------------------------
    // Validation Blueprints
    // -------------------------------------------------------------------------
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'name', 'email', 'phone', 'whatsapp', 'nationality', 'role', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && isNonEmptyStr(data.name, 120)
        && isNonEmptyStr(data.email, 200)
        && (!('phone' in data) || isOptionalStr(data.phone, 40))
        && (!('whatsapp' in data) || isOptionalStr(data.whatsapp, 40))
        && (!('nationality' in data) || isOptionalStr(data.nationality, 80))
        && data.role in ['customer', 'booking_agent', 'admin', 'super_admin']
        && data.status in ['active', 'blocked']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavedPassenger(data) {
      return data.keys().hasAll(['passengerId', 'userId', 'firstName', 'lastName', 'dateOfBirth', 'gender', 'nationality', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['passengerId', 'userId', 'firstName', 'lastName', 'dateOfBirth', 'gender', 'nationality', 'passportNumber', 'passportExpiry', 'createdAt', 'updatedAt'])
        && isValidId(data.passengerId)
        && isValidId(data.userId)
        && isNonEmptyStr(data.firstName, 80)
        && isNonEmptyStr(data.lastName, 80)
        && isNonEmptyStr(data.dateOfBirth, 20)
        && data.gender in ['Male', 'Female', 'Other']
        && isNonEmptyStr(data.nationality, 80)
        && (!('passportNumber' in data) || isOptionalStr(data.passportNumber, 40))
        && (!('passportExpiry' in data) || isOptionalStr(data.passportExpiry, 20))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminRole(data) {
      return data.keys().hasAll(['uid', 'email', 'name', 'role', 'assignedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'name', 'role', 'assignedBy', 'createdAt'])
        && isValidId(data.uid)
        && isNonEmptyStr(data.email, 200)
        && isNonEmptyStr(data.name, 120)
        && data.role in ['booking_agent', 'admin', 'super_admin']
        && isNonEmptyStr(data.assignedBy, 128)
        && data.createdAt is timestamp;
    }

    function isValidBooking(data) {
      return data.keys().hasAll([
        'bookingId', 'bookingReference', 'userId', 'mode', 'flightDetails',
        'passengers', 'contactDetails', 'totalAmount', 'currency',
        'paymentMethod', 'paymentStatus', 'bookingStatus', 'createdAt', 'updatedAt'
      ])
        && data.keys().hasOnly([
          'bookingId', 'bookingReference', 'userId', 'mode', 'flightDetails',
          'passengers', 'contactDetails', 'fareBreakdown', 'totalAmount', 'currency',
          'paymentMethod', 'paymentStatus', 'bookingStatus', 'supplierProvider',
          'supplierReference', 'ticketFileUrl', 'ticketFileName', 'internalNotes',
          'refundReason', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.bookingId)
        && isNonEmptyStr(data.bookingReference, 40)
        && isValidId(data.userId)
        && data.mode in ['demo', 'live']
        && data.flightDetails is map
        && data.passengers is list && data.passengers.size() >= 1 && data.passengers.size() <= 9
        && data.passengers[0] is map
        && data.contactDetails is map
        && (!('fareBreakdown' in data) || data.fareBreakdown is map)
        && data.totalAmount is number && data.totalAmount >= 0
        && isNonEmptyStr(data.currency, 10)
        && isNonEmptyStr(data.paymentMethod, 60)
        && data.paymentStatus in ['unpaid', 'pending_verification', 'confirmed', 'rejected', 'refund_pending', 'refunded']
        && data.bookingStatus in [
          'New Request', 'Pending Payment', 'Payment Verification',
          'Payment Confirmed', 'Supplier Confirmation Pending',
          'Ticket Issued', 'Cancelled', 'Refund Requested', 'Refunded'
        ]
        && (!('supplierProvider' in data) || isOptionalStr(data.supplierProvider, 60))
        && (!('supplierReference' in data) || isOptionalStr(data.supplierReference, 80))
        && (!('ticketFileUrl' in data) || isOptionalStr(data.ticketFileUrl, 600000))
        && (!('ticketFileName' in data) || isOptionalStr(data.ticketFileName, 180))
        && (!('internalNotes' in data) || isOptionalStr(data.internalNotes, 2000))
        && (!('refundReason' in data) || isOptionalStr(data.refundReason, 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFlightRequest(data) {
      return data.keys().hasAll([
        'requestId', 'requestReference', 'tripType', 'departureCity', 'destinationCity',
        'departureDate', 'preferredAirline', 'passengersCount', 'cabinClass',
        'passengerName', 'email', 'phoneWhatsapp', 'status', 'quotations',
        'paymentStatus', 'createdAt', 'updatedAt'
      ])
        && data.keys().hasOnly([
          'requestId', 'requestReference', 'userId', 'tripType', 'departureCity', 'destinationCity',
          'departureDate', 'returnDate', 'segments', 'preferredAirline', 'passengersCount', 'cabinClass',
          'passengerName', 'email', 'phoneWhatsapp', 'additionalRequirements', 'status', 'quotations',
          'selectedQuotationId', 'selectedQuotation', 'paymentMethod', 'paymentStatus',
          'transactionReference', 'paymentReceiptUrl', 'paymentReceiptFileName',
          'supplierProvider', 'supplierReference', 'ticketFileUrl', 'ticketFileName',
          'adminNotes', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.requestId)
        && isNonEmptyStr(data.requestReference, 40)
        && (!('userId' in data) || data.userId == null || isValidId(data.userId))
        && data.tripType in ['one-way', 'round-trip', 'multi-city']
        && isNonEmptyStr(data.departureCity, 160)
        && isNonEmptyStr(data.destinationCity, 160)
        && isNonEmptyStr(data.departureDate, 30)
        && (!('returnDate' in data) || isOptionalStr(data.returnDate, 30))
        && (!('segments' in data) || (data.segments is list && data.segments.size() <= 6 && (data.segments.size() == 0 || data.segments[0] is map)))
        && isNonEmptyStr(data.preferredAirline, 120)
        && data.passengersCount is map
        && data.cabinClass in ['Economy', 'Premium Economy', 'Business', 'First Class']
        && isNonEmptyStr(data.passengerName, 120)
        && isNonEmptyStr(data.email, 200)
        && isNonEmptyStr(data.phoneWhatsapp, 40)
        && (!('additionalRequirements' in data) || isOptionalStr(data.additionalRequirements, 2000))
        && data.status in [
          'New Request', 'Under Review', 'Quotation Sent', 'Awaiting Customer Approval',
          'Awaiting Payment', 'Payment Verified', 'Booking Confirmed', 'Ticket Issued', 'Cancelled'
        ]
        && data.quotations is list && data.quotations.size() <= 10 && (data.quotations.size() == 0 || data.quotations[0] is map)
        && (!('selectedQuotationId' in data) || isOptionalStr(data.selectedQuotationId, 128))
        && (!('selectedQuotation' in data) || data.selectedQuotation == null || data.selectedQuotation is map)
        && (!('paymentMethod' in data) || isOptionalStr(data.paymentMethod, 60))
        && data.paymentStatus in ['unpaid', 'pending_verification', 'verified', 'rejected']
        && (!('transactionReference' in data) || isOptionalStr(data.transactionReference, 120))
        && (!('paymentReceiptUrl' in data) || isOptionalStr(data.paymentReceiptUrl, 600000))
        && (!('paymentReceiptFileName' in data) || isOptionalStr(data.paymentReceiptFileName, 180))
        && (!('supplierProvider' in data) || isOptionalStr(data.supplierProvider, 80))
        && (!('supplierReference' in data) || isOptionalStr(data.supplierReference, 80))
        && (!('ticketFileUrl' in data) || isOptionalStr(data.ticketFileUrl, 600000))
        && (!('ticketFileName' in data) || isOptionalStr(data.ticketFileName, 180))
        && (!('adminNotes' in data) || isOptionalStr(data.adminNotes, 2000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPayment(data) {
      return data.keys().hasAll([
        'paymentId', 'bookingId', 'userId', 'amount', 'currency',
        'paymentMethod', 'verificationStatus', 'createdAt', 'updatedAt'
      ])
        && data.keys().hasOnly([
          'paymentId', 'bookingId', 'userId', 'amount', 'currency',
          'paymentMethod', 'receiptUrl', 'receiptFileName', 'transactionReference',
          'verificationStatus', 'adminRemarks', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.paymentId)
        && isValidId(data.bookingId)
        && isValidId(data.userId)
        && data.amount is number && data.amount >= 0
        && isNonEmptyStr(data.currency, 10)
        && isNonEmptyStr(data.paymentMethod, 60)
        && (!('receiptUrl' in data) || isOptionalStr(data.receiptUrl, 600000))
        && (!('receiptFileName' in data) || isOptionalStr(data.receiptFileName, 180))
        && (!('transactionReference' in data) || isOptionalStr(data.transactionReference, 120))
        && data.verificationStatus in ['pending', 'verified', 'rejected', 'refunded']
        && (!('adminRemarks' in data) || isOptionalStr(data.adminRemarks, 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFlightOffer(data) {
      return data.keys().hasAll([
        'offerId', 'airline', 'origin', 'destination', 'departureDate',
        'price', 'currency', 'baggage', 'validity', 'status', 'createdAt', 'updatedAt'
      ])
        && data.keys().hasOnly([
          'offerId', 'airline', 'airlineCode', 'flightNumber', 'origin', 'originCode',
          'destination', 'destinationCode', 'departureDate', 'returnDate', 'cabinClass',
          'price', 'currency', 'baggage', 'validity', 'notes', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.offerId)
        && isNonEmptyStr(data.airline, 120)
        && (!('airlineCode' in data) || isOptionalStr(data.airlineCode, 10))
        && (!('flightNumber' in data) || isOptionalStr(data.flightNumber, 20))
        && isNonEmptyStr(data.origin, 120)
        && (!('originCode' in data) || isOptionalStr(data.originCode, 10))
        && isNonEmptyStr(data.destination, 120)
        && (!('destinationCode' in data) || isOptionalStr(data.destinationCode, 10))
        && isNonEmptyStr(data.departureDate, 30)
        && (!('returnDate' in data) || isOptionalStr(data.returnDate, 30))
        && (!('cabinClass' in data) || isOptionalStr(data.cabinClass, 40))
        && data.price is number && data.price >= 0
        && isNonEmptyStr(data.currency, 10)
        && isNonEmptyStr(data.baggage, 80)
        && isNonEmptyStr(data.validity, 40)
        && (!('notes' in data) || isOptionalStr(data.notes, 500))
        && data.status in ['active', 'expired', 'draft']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDestination(data) {
      return data.keys().hasAll(['destinationId', 'name', 'country', 'airportCode', 'description', 'featured', 'updatedAt'])
        && data.keys().hasOnly(['destinationId', 'slug', 'name', 'country', 'airportCode', 'city', 'region', 'description', 'imageUrl', 'startingFare', 'currency', 'featured', 'order', 'updatedAt'])
        && isValidId(data.destinationId)
        && (!('slug' in data) || isOptionalStr(data.slug, 100))
        && isNonEmptyStr(data.name, 100)
        && isNonEmptyStr(data.country, 100)
        && isNonEmptyStr(data.airportCode, 10)
        && (!('city' in data) || isOptionalStr(data.city, 100))
        && (!('region' in data) || data.region in ['international', 'domestic', 'usa_featured'])
        && isNonEmptyStr(data.description, 500)
        && (!('imageUrl' in data) || isOptionalStr(data.imageUrl, 1000))
        && (!('startingFare' in data) || data.startingFare is number)
        && (!('currency' in data) || isOptionalStr(data.currency, 10))
        && data.featured is bool
        && (!('order' in data) || data.order is number)
        && data.updatedAt is timestamp;
    }

    function isValidTravelPackage(data) {
      return data.keys().hasAll(['packageId', 'title', 'category', 'destination', 'duration', 'description', 'status', 'updatedAt'])
        && data.keys().hasOnly(['packageId', 'title', 'category', 'destination', 'destinationSlug', 'duration', 'price', 'currency', 'description', 'includedServices', 'imageUrl', 'featured', 'status', 'updatedAt'])
        && isValidId(data.packageId)
        && isNonEmptyStr(data.title, 140)
        && data.category in ['tour', 'honeymoon', 'hajj_umrah', 'holiday']
        && isNonEmptyStr(data.destination, 120)
        && (!('destinationSlug' in data) || isOptionalStr(data.destinationSlug, 100))
        && isNonEmptyStr(data.duration, 60)
        && (!('price' in data) || data.price is number)
        && (!('currency' in data) || isOptionalStr(data.currency, 10))
        && isNonEmptyStr(data.description, 800)
        && (!('includedServices' in data) || (data.includedServices is list && data.includedServices.size() <= 15 && (data.includedServices.size() == 0 || data.includedServices[0] is string)))
        && (!('imageUrl' in data) || isOptionalStr(data.imageUrl, 1000))
        && (!('featured' in data) || data.featured is bool)
        && data.status in ['active', 'inactive']
        && data.updatedAt is timestamp;
    }

    function isValidHotel(data) {
      return data.keys().hasAll(['hotelId', 'name', 'city', 'country', 'category', 'starRating', 'description', 'status', 'updatedAt'])
        && data.keys().hasOnly(['hotelId', 'name', 'city', 'country', 'category', 'pricePerNight', 'currency', 'starRating', 'description', 'amenities', 'imageUrl', 'featured', 'status', 'updatedAt'])
        && isValidId(data.hotelId)
        && isNonEmptyStr(data.name, 140)
        && isNonEmptyStr(data.city, 100)
        && isNonEmptyStr(data.country, 100)
        && data.category in ['luxury_resort', 'city_business', 'haram_proximity', 'budget']
        && (!('pricePerNight' in data) || data.pricePerNight is number)
        && (!('currency' in data) || isOptionalStr(data.currency, 10))
        && data.starRating is number && data.starRating >= 1 && data.starRating <= 5
        && isNonEmptyStr(data.description, 800)
        && (!('amenities' in data) || (data.amenities is list && data.amenities.size() <= 15 && (data.amenities.size() == 0 || data.amenities[0] is string)))
        && (!('imageUrl' in data) || isOptionalStr(data.imageUrl, 1000))
        && (!('featured' in data) || data.featured is bool)
        && data.status in ['active', 'inactive']
        && data.updatedAt is timestamp;
    }

    function isValidFaq(data) {
      return data.keys().hasAll(['faqId', 'question', 'answer', 'order', 'status', 'updatedAt'])
        && data.keys().hasOnly(['faqId', 'question', 'answer', 'category', 'order', 'status', 'updatedAt'])
        && isValidId(data.faqId)
        && isNonEmptyStr(data.question, 300)
        && isNonEmptyStr(data.answer, 2000)
        && (!('category' in data) || isOptionalStr(data.category, 80))
        && data.order is number
        && data.status in ['published', 'hidden']
        && data.updatedAt is timestamp;
    }

    function isValidSpecialOffer(data) {
      return data.keys().hasAll(['offerId', 'title', 'description', 'destination', 'discountLabel', 'validUntil', 'status', 'updatedAt'])
        && data.keys().hasOnly(['offerId', 'title', 'subtitle', 'description', 'destination', 'discountLabel', 'promoCode', 'validUntil', 'status', 'updatedAt'])
        && isValidId(data.offerId)
        && isNonEmptyStr(data.title, 140)
        && (!('subtitle' in data) || isOptionalStr(data.subtitle, 140))
        && isNonEmptyStr(data.description, 600)
        && isNonEmptyStr(data.destination, 100)
        && isNonEmptyStr(data.discountLabel, 60)
        && (!('promoCode' in data) || isOptionalStr(data.promoCode, 40))
        && isNonEmptyStr(data.validUntil, 40)
        && data.status in ['active', 'inactive']
        && data.updatedAt is timestamp;
    }

    function isValidTestimonial(data) {
      return data.keys().hasAll(['testimonialId', 'customerName', 'route', 'rating', 'quote', 'status', 'updatedAt'])
        && data.keys().hasOnly(['testimonialId', 'customerName', 'city', 'route', 'rating', 'quote', 'status', 'updatedAt'])
        && isValidId(data.testimonialId)
        && isNonEmptyStr(data.customerName, 100)
        && (!('city' in data) || isOptionalStr(data.city, 80))
        && isNonEmptyStr(data.route, 100)
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && isNonEmptyStr(data.quote, 600)
        && data.status in ['published', 'hidden']
        && data.updatedAt is timestamp;
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['inquiryId', 'name', 'email', 'phone', 'subject', 'message', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['inquiryId', 'userId', 'bookingId', 'name', 'email', 'phone', 'subject', 'message', 'status', 'adminReply', 'createdAt', 'updatedAt'])
        && isValidId(data.inquiryId)
        && (!('userId' in data) || data.userId == null || isValidId(data.userId))
        && (!('bookingId' in data) || data.bookingId == null || isOptionalStr(data.bookingId, 128))
        && isNonEmptyStr(data.name, 120)
        && isNonEmptyStr(data.email, 200)
        && isNonEmptyStr(data.phone, 40)
        && isNonEmptyStr(data.subject, 200)
        && isNonEmptyStr(data.message, 2000)
        && data.status in ['new', 'in_progress', 'resolved']
        && (!('adminReply' in data) || isOptionalStr(data.adminReply, 2000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNewsletter(data) {
      return data.keys().hasAll(['email', 'createdAt'])
        && data.keys().hasOnly(['email', 'createdAt'])
        && isNonEmptyStr(data.email, 200)
        && data.createdAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['notificationId', 'userId', 'type', 'title', 'message', 'read', 'createdAt'])
        && data.keys().hasOnly(['notificationId', 'userId', 'bookingId', 'type', 'title', 'message', 'read', 'createdAt'])
        && isValidId(data.notificationId)
        && isValidId(data.userId)
        && (!('bookingId' in data) || isOptionalStr(data.bookingId, 128))
        && isNonEmptyStr(data.type, 80)
        && isNonEmptyStr(data.title, 160)
        && isNonEmptyStr(data.message, 600)
        && data.read is bool
        && data.createdAt is timestamp;
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['agencyName', 'operatingMode', 'defaultCurrency', 'updatedAt'])
        && data.keys().hasOnly([
          'agencyName', 'tagline', 'logoUrl', 'heroBannerUrl', 'seoTitle', 'seoDescription',
          'executiveName', 'executiveRole', 'operatingMode', 'defaultCurrency',
          'whatsappNumber', 'contactEmail', 'contactPhone', 'secondaryPhone', 'officeAddress',
          'socialLinks', 'paymentMethods', 'bankDetails', 'faqs',
          'legalPages', 'heroTitle', 'heroSubtitle', 'footerText', 'updatedAt'
        ])
        && isNonEmptyStr(data.agencyName, 120)
        && (!('tagline' in data) || isOptionalStr(data.tagline, 300))
        && (!('logoUrl' in data) || isOptionalStr(data.logoUrl, 1000))
        && (!('heroBannerUrl' in data) || isOptionalStr(data.heroBannerUrl, 1000))
        && (!('seoTitle' in data) || isOptionalStr(data.seoTitle, 160))
        && (!('seoDescription' in data) || isOptionalStr(data.seoDescription, 400))
        && (!('executiveName' in data) || isOptionalStr(data.executiveName, 120))
        && (!('executiveRole' in data) || isOptionalStr(data.executiveRole, 120))
        && data.operatingMode in ['demo', 'live']
        && isNonEmptyStr(data.defaultCurrency, 10)
        && (!('whatsappNumber' in data) || isOptionalStr(data.whatsappNumber, 40))
        && (!('contactEmail' in data) || isOptionalStr(data.contactEmail, 200))
        && (!('contactPhone' in data) || isOptionalStr(data.contactPhone, 40))
        && (!('secondaryPhone' in data) || isOptionalStr(data.secondaryPhone, 40))
        && (!('officeAddress' in data) || isOptionalStr(data.officeAddress, 300))
        && (!('socialLinks' in data) || data.socialLinks is map)
        && (!('paymentMethods' in data) || data.paymentMethods is map)
        && (!('bankDetails' in data) || data.bankDetails is map)
        && (!('faqs' in data) || (data.faqs is list && data.faqs.size() <= 30 && (data.faqs.size() == 0 || data.faqs[0] is map)))
        && (!('legalPages' in data) || data.legalPages is map)
        && (!('heroTitle' in data) || isOptionalStr(data.heroTitle, 200))
        && (!('heroSubtitle' in data) || isOptionalStr(data.heroSubtitle, 600))
        && (!('footerText' in data) || isOptionalStr(data.footerText, 600))
        && data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['logId', 'actorUid', 'actorEmail', 'action', 'targetCollection', 'targetId', 'details', 'createdAt'])
        && data.keys().hasOnly(['logId', 'actorUid', 'actorEmail', 'action', 'targetCollection', 'targetId', 'details', 'createdAt'])
        && isValidId(data.logId)
        && isValidId(data.actorUid)
        && isNonEmptyStr(data.actorEmail, 200)
        && isNonEmptyStr(data.action, 160)
        && isNonEmptyStr(data.targetCollection, 80)
        && isNonEmptyStr(data.targetId, 128)
        && isNonEmptyStr(data.details, 1000)
        && data.createdAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Match Blocks
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isVerifiedUser()
        && isValidUser(incoming())
        && incoming().uid == userId
        && request.auth.uid == userId
        && incoming().role == 'customer'
        && incoming().status == 'active'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isValidUser(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isSuperAdmin() ||
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && incoming().role == existing().role) ||
          (isOwner(userId) && existing().status == 'active' && incoming().role == existing().role && incoming().status == existing().status && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'whatsapp', 'nationality', 'updatedAt']))
        );
      allow delete: if false;
    }

    match /passengers/{passengerId} {
      allow get: if isValidId(passengerId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(passengerId)
        && isVerifiedUser()
        && isValidSavedPassenger(incoming())
        && incoming().passengerId == passengerId
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(passengerId)
        && isVerifiedUser()
        && isValidSavedPassenger(incoming())
        && incoming().passengerId == existing().passengerId
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (existing().userId == request.auth.uid || isAdmin());
      allow delete: if isValidId(passengerId) && isVerifiedUser() && (existing().userId == request.auth.uid || isAdmin());
    }

    match /admins/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(uid)
        && isSuperAdmin()
        && isValidAdminRole(incoming())
        && incoming().uid == uid
        && incoming().createdAt == request.time;
      allow update: if isValidId(uid)
        && isSuperAdmin()
        && isValidAdminRole(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'assignedBy']);
      allow delete: if isValidId(uid) && isSuperAdmin() && uid != request.auth.uid;
    }

    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && isSignedIn() && (existing().userId == request.auth.uid || isStaff());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isStaff());
      allow create: if isValidId(bookingId)
        && isVerifiedUser()
        && isValidBooking(incoming())
        && incoming().bookingId == bookingId
        && incoming().userId == request.auth.uid
        && incoming().paymentStatus == 'unpaid'
        && incoming().bookingStatus in ['New Request', 'Pending Payment']
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(bookingId)
        && isVerifiedUser()
        && isValidBooking(incoming())
        && incoming().bookingId == existing().bookingId
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isStaff() ||
          (
            existing().userId == request.auth.uid
            && !(existing().bookingStatus in ['Ticket Issued', 'Cancelled', 'Refunded'])
            && (
              (incoming().diff(existing()).affectedKeys().hasOnly(['paymentMethod', 'paymentStatus', 'bookingStatus', 'updatedAt'])
                && incoming().paymentStatus == 'pending_verification'
                && incoming().bookingStatus == 'Payment Verification') ||
              (incoming().diff(existing()).affectedKeys().hasOnly(['bookingStatus', 'refundReason', 'updatedAt'])
                && incoming().bookingStatus in ['Cancelled', 'Refund Requested'])
            )
          )
        );
      allow delete: if false;
    }

    match /flightRequests/{requestId} {
      allow get: if isValidId(requestId) && isSignedIn() && (
        isStaff() ||
        (isVerifiedUser() && (existing().userId == request.auth.uid || existing().email == request.auth.token.email))
      );
      allow list: if isStaff() || (
        isVerifiedUser() && (resource.data.userId == request.auth.uid || resource.data.email == request.auth.token.email)
      );
      allow create: if isValidId(requestId)
        && isValidFlightRequest(incoming())
        && incoming().requestId == requestId
        && incoming().status == 'New Request'
        && incoming().paymentStatus == 'unpaid'
        && incoming().quotations.size() == 0
        && (!('ticketFileUrl' in incoming()) || incoming().ticketFileUrl == '')
        && (!('supplierReference' in incoming()) || incoming().supplierReference == '')
        && (!('userId' in incoming()) || incoming().userId == null || (isVerifiedUser() && incoming().userId == request.auth.uid))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(requestId)
        && isVerifiedUser()
        && isValidFlightRequest(incoming())
        && incoming().requestId == existing().requestId
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isStaff() ||
          (
            (existing().userId == request.auth.uid || existing().email == request.auth.token.email)
            && !(existing().status in ['Ticket Issued', 'Cancelled'])
            && (
              (
                existing().status in ['Quotation Sent', 'Awaiting Customer Approval']
                && incoming().status == 'Awaiting Payment'
                && incoming().selectedQuotationId is string && incoming().selectedQuotationId.size() >= 1
                && incoming().diff(existing()).affectedKeys().hasOnly(['selectedQuotationId', 'selectedQuotation', 'status', 'updatedAt'])
              ) ||
              (
                existing().status == 'Awaiting Payment'
                && incoming().status == 'Awaiting Payment'
                && incoming().paymentStatus == 'pending_verification'
                && incoming().diff(existing()).affectedKeys().hasOnly(['paymentMethod', 'transactionReference', 'paymentReceiptUrl', 'paymentReceiptFileName', 'paymentStatus', 'updatedAt'])
              ) ||
              (
                !(existing().status in ['Booking Confirmed', 'Ticket Issued', 'Cancelled'])
                && incoming().status == 'Cancelled'
                && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
              )
            )
          )
        );
      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow get: if isValidId(paymentId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(paymentId)
        && isVerifiedUser()
        && isValidPayment(incoming())
        && incoming().paymentId == paymentId
        && incoming().userId == request.auth.uid
        && incoming().verificationStatus == 'pending'
        && exists(/databases/$(database)/documents/bookings/$(incoming().bookingId))
        && get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(paymentId)
        && isAdmin()
        && isValidPayment(incoming())
        && incoming().paymentId == existing().paymentId
        && incoming().bookingId == existing().bookingId
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['verificationStatus', 'adminRemarks', 'updatedAt']);
      allow delete: if false;
    }

    match /flightOffers/{offerId} {
      allow get: if isValidId(offerId);
      allow list: if true;
      allow create: if isValidId(offerId)
        && isAdmin()
        && isValidFlightOffer(incoming())
        && incoming().offerId == offerId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(offerId)
        && isAdmin()
        && isValidFlightOffer(incoming())
        && incoming().offerId == existing().offerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(offerId) && isAdmin();
    }

    match /destinations/{destinationId} {
      allow get: if isValidId(destinationId);
      allow list: if true;
      allow create: if isValidId(destinationId)
        && isAdmin()
        && isValidDestination(incoming())
        && incoming().destinationId == destinationId
        && incoming().updatedAt == request.time;
      allow update: if isValidId(destinationId)
        && isAdmin()
        && isValidDestination(incoming())
        && incoming().destinationId == existing().destinationId
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(destinationId) && isAdmin();
    }

    match /travelPackages/{packageId} {
      allow get: if isValidId(packageId);
      allow list: if true;
      allow create: if isValidId(packageId)
        && isAdmin()
        && isValidTravelPackage(incoming())
        && incoming().packageId == packageId
        && incoming().updatedAt == request.time;
      allow update: if isValidId(packageId)
        && isAdmin()
        && isValidTravelPackage(incoming())
        && incoming().packageId == existing().packageId
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(packageId) && isAdmin();
    }

    match /offers/{offerId} {
      allow get: if isValidId(offerId);
      allow list: if true;
      allow create: if isValidId(offerId)
        && isAdmin()
        && isValidSpecialOffer(incoming())
        && incoming().offerId == offerId
        && incoming().updatedAt == request.time;
      allow update: if isValidId(offerId)
        && isAdmin()
        && isValidSpecialOffer(incoming())
        && incoming().offerId == existing().offerId
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(offerId) && isAdmin();
    }

    match /hotels/{hotelId} {
      allow get: if isValidId(hotelId);
      allow list: if true;
      allow create: if isValidId(hotelId)
        && isAdmin()
        && isValidHotel(incoming())
        && incoming().hotelId == hotelId
        && incoming().updatedAt == request.time;
      allow update: if isValidId(hotelId)
        && isAdmin()
        && isValidHotel(incoming())
        && incoming().hotelId == existing().hotelId
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(hotelId) && isAdmin();
    }

    match /faqs/{faqId} {
      allow get: if isValidId(faqId) && (existing().status == 'published' || isAdmin());
      allow list: if resource.data.status == 'published' || isAdmin();
      allow create: if isValidId(faqId)
        && isAdmin()
        && isValidFaq(incoming())
        && incoming().faqId == faqId
        && incoming().updatedAt == request.time;
      allow update: if isValidId(faqId)
        && isAdmin()
        && isValidFaq(incoming())
        && incoming().faqId == existing().faqId
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(faqId) && isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow get: if isValidId(testimonialId) && (existing().status == 'published' || isAdmin());
      allow list: if resource.data.status == 'published' || isAdmin();
      allow create: if isValidId(testimonialId)
        && isAdmin()
        && isValidTestimonial(incoming())
        && incoming().testimonialId == testimonialId
        && incoming().updatedAt == request.time;
      allow update: if isValidId(testimonialId)
        && isAdmin()
        && isValidTestimonial(incoming())
        && incoming().testimonialId == existing().testimonialId
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(testimonialId) && isAdmin();
    }

    match /inquiries/{inquiryId} {
      allow get: if isValidId(inquiryId) && isSignedIn() && (existing().userId == request.auth.uid || isStaff());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isStaff());
      allow create: if isValidId(inquiryId)
        && isValidInquiry(incoming())
        && incoming().inquiryId == inquiryId
        && incoming().status == 'new'
        && (!('userId' in incoming()) || incoming().userId == null || (isSignedIn() && incoming().userId == request.auth.uid))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(inquiryId)
        && isStaff()
        && isValidInquiry(incoming())
        && incoming().inquiryId == existing().inquiryId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminReply', 'updatedAt']);
      allow delete: if false;
    }

    match /newsletter/{subscriberId} {
      allow get: if isValidId(subscriberId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(subscriberId)
        && isValidNewsletter(incoming())
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isSignedIn() && (existing().userId == request.auth.uid || isStaff());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isStaff());
      allow create: if isValidId(notificationId)
        && isVerifiedUser()
        && isValidNotification(incoming())
        && incoming().notificationId == notificationId
        && (incoming().userId == request.auth.uid || isStaff())
        && incoming().createdAt == request.time;
      allow update: if isValidId(notificationId)
        && isVerifiedUser()
        && isValidNotification(incoming())
        && incoming().notificationId == existing().notificationId
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().userId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    match /siteSettings/{settingId} {
      allow get: if isValidId(settingId) && (settingId == 'general' || settingId == 'public' || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(settingId)
        && isAdmin()
        && isValidSettings(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isValidId(settingId)
        && isAdmin()
        && isValidSettings(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /websiteSettings/{settingId} {
      allow get: if isValidId(settingId) && (settingId == 'public' || settingId == 'general' || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(settingId)
        && isAdmin()
        && isValidSettings(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isValidId(settingId)
        && isAdmin()
        && isValidSettings(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId) && (settingId == 'public' || settingId == 'general' || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(settingId)
        && isAdmin()
        && isValidSettings(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isValidId(settingId)
        && isAdmin()
        && isValidSettings(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(logId)
        && isStaff()
        && isValidAuditLog(incoming())
        && incoming().logId == logId
        && incoming().actorUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
