# =============================================================================
# THE KING TRAVEL — ENVIRONMENT VARIABLES EXAMPLE
# Copy to `.env` for local development. NEVER commit real secrets to Git!
# Configure private keys in Netlify: Site Configuration > Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# Build & Hosting Configuration (Safe for Build Time / Public Frontend)
# -----------------------------------------------------------------------------
# Root domain deployment (Netlify / Node / Firebase Hosting):
#   VITE_BASE_PATH="/"
#   VITE_HASH_ROUTER="false"
# Subdirectory deployment (GitHub Pages):
#   VITE_BASE_PATH="./"
#   VITE_HASH_ROUTER="true"
VITE_BASE_PATH="/"
VITE_HASH_ROUTER="false"

# Canonical site URL (automatically set by Netlify `URL` in serverless functions,
# or specify explicitly for sitemaps and Stripe checkout return URLs).
APP_URL="https://www.thekingtravel.com"

# -----------------------------------------------------------------------------
# Optional Gemini AI Key (Server-Side Only — Never Expose in VITE_* Variables)
# -----------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# -----------------------------------------------------------------------------
# Flight Supplier APIs (Server-Side Only — Netlify Functions / Express Server)
# Website still builds and runs cleanly in Demo / Manual Request mode if blank.
# -----------------------------------------------------------------------------
# Amadeus Self-Service APIs (https://developers.amadeus.com)
AMADEUS_CLIENT_ID=""
AMADEUS_CLIENT_SECRET=""
AMADEUS_BASE_URL="https://test.api.amadeus.com"

# Duffel Flights API (https://duffel.com)
DUFFEL_ACCESS_TOKEN=""
DUFFEL_BASE_URL="https://api.duffel.com"

# -----------------------------------------------------------------------------
# Payment Gateways (Server-Side Only — Never Expose in Frontend Code)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYFAST_PK_MERCHANT_ID=""
PAYFAST_PK_SECURED_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# Agency & Customer Notifications (Server-Side Only)
# -----------------------------------------------------------------------------
AGENCY_EMAIL="bookings@example.com"
RESEND_API_KEY=""
EMAIL_FROM="bookings@example.com"
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
